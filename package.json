{
  "name": "opencode-conn",
  "displayName": "opencode-conn",
  "description": "opencode connector for VS Code",
  "version": "1.0.0",
  "publisher": "weimh",
  "repository": {
    "type": "git",
    "url": "https://github.com/weiminghaoo/opencode-conn"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#000000",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "opencode-conn.copyCommand",
        "title": "复制 opencode 启动命令"
      },
      {
        "command": "opencode-conn.addFilepathToTerminal",
        "title": "添加文件路径到 opencode"
      }
    ],
    "menus": {},
    "keybindings": [
      {
        "command": "opencode-conn.addFilepathToTerminal",
        "title": "opencode: Insert At-Mentioned",
        "key": "cmd+alt+k",
        "mac": "cmd+alt+k",
        "win": "ctrl+alt+K",
        "linux": "ctrl+alt+K"
      }
    ]
  },
  "scripts": {
    "build": "npm run check-types && npm run lint && node esbuild.js",
    "dev": "node esbuild.js --watch",
    "package": "npm run check-types && npm run lint && node esbuild.js --production && npm run vsix",
    "vsix": "vsce package --no-git-tag-version --no-update-package-json --no-dependencies --skip-license -o dist/opencode-conn.vsix",
    "check-types": "tsc --noEmit",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/node": "~20.19.43",
    "@types/vscode": "^1.94.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.3",
    "eslint": "^9.25.1",
    "typescript": "^5.8.3"
  },
  "volta": {
    "node": "22.19.0"
  }
}