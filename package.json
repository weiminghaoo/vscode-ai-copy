{
  "name": "ai-copy",
  "displayName": "AI Copy",
  "description": "快速复制 AI 可用的代码引用（@文件#行号）",
  "version": "1.0.0",
  "publisher": "weimh",
  "repository": {
    "type": "git",
    "url": "https://github.com/weiminghaoo/vscode-ai-copy"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#000000",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ai-copy.copyReference",
        "title": "Copy AI Reference"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "ai-copy.copyReference",
          "group": "9_cutcopypaste@1",
          "when": "editorTextFocus"
        }
      ]
    },
    "configuration": {
      "title": "AI Copy",
      "properties": {
        "ai-copy.keybinding": {
          "type": "string",
          "default": "cmd+alt+k",
          "markdownDescription": "「Copy AI Reference」的快捷键。修改后会自动写入 VS Code 的 `keybindings.json`，右键菜单中也会显示该快捷键。非 macOS 平台会自动把 `cmd` 映射为 `ctrl`。"
        }
      }
    }
  },
  "scripts": {
    "build": "npm run check-types && npm run lint && node esbuild.js",
    "dev": "node esbuild.js --watch",
    "package": "npm run check-types && npm run lint && node esbuild.js --production && npm run vsix",
    "vsix": "vsce package --no-git-tag-version --no-update-package-json --no-dependencies --skip-license -o dist/ai-copy.vsix",
    "check-types": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "~20.19.43",
    "@types/vscode": "^1.94.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.3",
    "eslint": "^9.25.1",
    "typescript": "^5.8.3"
  },
  "volta": {
    "node": "22.19.0"
  }
}